{
  "name": "ai-interview-trainer",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "description": "AI 面试训练器",
  "scripts": {
    "dev": "trap 'kill $VITE_PID $SERVER_PID 2>/dev/null' EXIT INT TERM; vite & VITE_PID=$!; node server/index.js & SERVER_PID=$!; wait",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "question:coverage": "node scripts/question-coverage.ts",
    "question:blueprint": "node scripts/question-blueprint.ts",
    "question:audit": "python analysis/question_audit.py",
    "question:analysis": "uv run --project analysis --extra analysis python analysis/question_analysis.py",
    "question:add": "node scripts/add-question.ts",
    "question:review": "node scripts/review-question.ts",
    "question:curate": "python analysis/question_curate.py",
    "question:curate:semantic": "uv run --project analysis --extra analysis python analysis/question_analysis.py --semantic --json > analysis/curation-semantic-report.json && python analysis/question_curate.py --semantic-report analysis/curation-semantic-report.json",
    "validate:questions": "node scripts/validate-questions.ts",
    "question:identity": "node scripts/check-question-identity.ts",
    "question:quality": "node scripts/audit-question-quality.ts",
    "question:variants": "vite-node scripts/question-variants.ts",
    "question:validate-variants": "vite-node scripts/validate-variants.ts",
    "lint:bias": "node scripts/lint-bias.ts",
    "lint:length": "node scripts/lint-length.ts",
    "fix:bias": "node scripts/fix-bias.ts",
    "backfill:misconceptions": "node scripts/backfill-misconceptions.ts",
    "cloudflare:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/x": "^2.9.0",
    "@dagrejs/graphlib": "^4.0.5",
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "@monaco-editor/react": "^4.7.0",
    "antd": "^6.6.2",
    "dexie": "^4.4.5",
    "express": "^5.2.1",
    "fuzzball": "^2.2.6",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "shiki": "^4.4.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
